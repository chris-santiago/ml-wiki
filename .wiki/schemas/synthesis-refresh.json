{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "synthesis-refresh",
  "description": "Synthesis refresh agent output — updated synthesis with new evidence",
  "type": "object",
  "required": ["synthesis", "sources", "tags"],
  "properties": {
    "synthesis": {"type": "string", "minLength": 1},
    "sources": {
      "type": "array",
      "items": {"type": "string"},
      "minItems": 1
    },
    "tags": {
      "type": "array",
      "items": {"type": "string"}
    },
    "fragments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["seq", "type", "title"],
        "properties": {
          "seq": {"type": "integer", "minimum": 1},
          "type": {"type": "string", "enum": ["claim", "method", "finding", "dataset", "metric", "question", "definition", "description"]},
          "title": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
